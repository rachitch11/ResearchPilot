# ResearchPilot environment configuration
# Copy this file to .env for local development. Never commit real values.

# AI provider credentials
GEMINI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
AI_REQUEST_TIMEOUT_MS=30000
GROQ_API_KEY=

# Search provider credentials
# Brave Search API key; keep it in Replit Secrets or local .env only.
SEARCH_API_KEY=
SEARCH_PROVIDER=brave
SEARCH_REQUEST_TIMEOUT_MS=15000
MAX_RESULTS_PER_QUERY=5

# Private admin access (configured in a later build phase)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Session and runtime configuration
SESSION_SECRET=replace-with-a-long-random-value
NODE_ENV=development

# Free-tier protection defaults
MAX_RESEARCH_PER_HOUR=3
MAX_SEARCHES_PER_RESEARCH=8
MAX_SOURCES_PER_RESEARCH=12
MAX_RESEARCH_TIME=120